{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortLens",
  "version": "0.1.0",
  "identifier": "dev.portlens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PortLens",
        "width": 980,
        "height": 620,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Inspect local ports and stop development processes",
    "longDescription": "A compact desktop utility for identifying local listening ports, their owning applications, and stopping unwanted development process trees.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
